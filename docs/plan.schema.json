{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silora plan protocol v1",
  "type": "object",
  "required": ["schema_version", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["plan_ready", "clarification_required"]},
    "question": {"type": "string", "minLength": 1},
    "missing_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "operation": {"enum": ["add", "replace"]},
    "time_zone": {"type": "string"},
    "scope": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "intervals": {"type": "array", "maxItems": 2000, "items": {"type": "object", "required": ["start", "end", "mode", "label"], "properties": {
      "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"},
      "start": {"type": "string", "format": "date-time"},
      "end": {"type": "string", "format": "date-time"},
      "mode": {"enum": ["ring", "vibrate", "silent"]},
      "label": {"type": "string", "minLength": 1, "maxLength": 120},
      "enabled": {"type": "boolean"}
    }}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "plan_ready"}}}, "then": {"required": ["operation", "time_zone", "intervals"]}, "else": {"required": ["question", "missing_fields"]}},
    {"if": {"required": ["operation"], "properties": {"operation": {"const": "replace"}}}, "then": {"required": ["scope"]}}
  ]
}
